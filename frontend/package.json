{
  "name": "kompas-kompetencji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:types": "openapi-typescript --output src/lib/api/schema.d.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "doctor": "react-doctor --verbose --yes --no-score --no-supply-chain --blocking none",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "precommit": "npm run format && npm run check"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "react-doctor": "^0.9.23",
    "tailwindcss": "4.3.5",
    "typescript": "^5.0.0",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
