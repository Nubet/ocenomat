# Local development only. Replace all CHANGE_ME values before starting.
# Use URL-safe random values, e.g. openssl rand -hex 24.
POSTGRES_USER=kompas
POSTGRES_DB=kompas
POSTGRES_PASSWORD=CHANGE_ME
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
KOMPAS_STORAGE_BUCKET=kompas-private

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
KOMPAS_CORS_ORIGINS=["http://localhost:3000"]

# Supabase Cloud Auth (HTTPS origin, no /auth/v1 suffix).
# Leave unset until configured; authenticated endpoints return 503, no bypass.
KOMPAS_SUPABASE_URL=
KOMPAS_JWT_ALGORITHM=ES256
SUPABASE_PUBLISHABLE_KEY=

# Server-side AI only; no generation until the key is set.
# Paid presentation default, checked in the public catalog on 2026-11-21.
# Availability/capabilities are checked before the first generation, not assumed.
KOMPAS_LLM_PROVIDER=openrouter
KOMPAS_LLM_MODEL=anthropic/claude-sonnet-5.5
KOMPAS_LLM_API_KEY=
KOMPAS_LLM_BASE_URL=https://openrouter.ai/api/v1
KOMPAS_LLM_TIMEOUT_SECONDS=60
KOMPAS_LLM_MAX_TOKENS=8192
KOMPAS_LLM_REASONING_EFFORT=medium
