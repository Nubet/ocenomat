# Local development only. Replace all CHANGE_ME values before starting.
# Use URL-safe random values, e.g. openssl rand -hex 24.
POSTGRES_USER=kompas
POSTGRES_DB=kompas
POSTGRES_PASSWORD=CHANGE_ME
RUSTFS_ACCESS_KEY=CHANGE_ME
RUSTFS_SECRET_KEY=CHANGE_ME
KOMPAS_STORAGE_BUCKET=kompas-private

FRONTEND_PORT=3000
BACKEND_PORT=8000
POSTGRES_PORT=5432
RUSTFS_PORT=9000
RUSTFS_CONSOLE_PORT=9001
KOMPAS_CORS_ORIGINS=["http://localhost:3000"]

# Supabase Cloud Auth (HTTPS origin, no /auth/v1 suffix).
# Leave unset until configured; authenticated endpoints return 503, no bypass.
KOMPAS_SUPABASE_URL=
KOMPAS_JWT_ALGORITHM=ES256
SUPABASE_PUBLISHABLE_KEY=
